# ============================================================
# INTERACTIVE-DECOX // ENVIRONMENT
# ============================================================
# Never commit the real .env file.

# ---------------------------
# Server-only secrets
# ---------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Exact Stripe Price IDs used to map a paid Checkout Session to a service.
STRIPE_DISCOVERY_PRICE_ID=
STRIPE_MAGISTRAL_PRICE_ID=

# Optional: forward verified Stripe purchase events to your fulfillment system.
PURCHASE_EVENT_WEBHOOK_URL=

# Contact form delivery through Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ---------------------------
# Browser-visible configuration
# ---------------------------
# These values are safe to expose in the browser.
VITE_STRIPE_DISCOVERY_URL=
VITE_STRIPE_MAGISTRAL_URL=

VITE_WHATSAPP_NUMBER=
VITE_WHATSAPP_MESSAGE=

# Supabase OAuth consent route (/oauth/consent)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
