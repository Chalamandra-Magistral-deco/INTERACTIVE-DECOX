{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/ads.txt", "destination": "/ads.txt" },
    { "source": "/app-ads.txt", "destination": "/app-ads.txt" },
    {
      "source": "/((?!api/|assets/|_vercel/|favicon\\.ico|robots\\.txt|sitemap\\.xml|ads\\.txt|app-ads\\.txt|googlex.*\\.html|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/ads.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "interest-cohort=(), camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
